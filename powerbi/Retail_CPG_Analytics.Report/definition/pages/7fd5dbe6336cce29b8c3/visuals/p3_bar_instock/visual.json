{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "p3_bar_instock",
  "position": {
    "x": 30,
    "y": 260,
    "z": 4,
    "height": 270,
    "width": 560,
    "tabOrder": 4
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Category"
                    }
                  },
                  "Property": "category_name"
                }
              },
              "queryRef": "Dim_Category.category_name",
              "nativeQueryRef": "category_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_Inventory"
                    }
                  },
                  "Property": "In-Stock Rate"
                }
              },
              "queryRef": "Fact_Inventory.In-Stock Rate",
              "nativeQueryRef": "In-Stock Rate"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_Inventory"
                    }
                  },
                  "Property": "Fill Rate"
                }
              },
              "queryRef": "Fact_Inventory.Fill Rate",
              "nativeQueryRef": "Fill Rate"
            }
          ]
        }
      }
    },
    "objects": {
      "valueAxis": [
        {
          "properties": {
            "start": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            },
            "end": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}