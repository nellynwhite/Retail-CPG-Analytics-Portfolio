{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "fe_bar_supplier",
  "position": {
    "x": 630,
    "y": 230,
    "z": 13,
    "height": 550,
    "width": 610,
    "tabOrder": 13
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Supplier"
                    }
                  },
                  "Property": "supplier_name"
                }
              },
              "queryRef": "Dim_Supplier.supplier_name",
              "nativeQueryRef": "supplier_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_SupplyChain"
                    }
                  },
                  "Property": "OTIF Fine Exposure $"
                }
              },
              "queryRef": "Fact_SupplyChain.OTIF Fine Exposure $",
              "nativeQueryRef": "OTIF Fine Exposure $"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Fine Exposure $ by Supplier'"
                }
              }
            }
          }
        }
      ]
    }
  }
}