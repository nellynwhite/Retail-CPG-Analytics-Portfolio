{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "p4_line_promo",
  "position": {
    "x": 30,
    "y": 550,
    "z": 6,
    "height": 240,
    "width": 560,
    "tabOrder": 6
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Date"
                    }
                  },
                  "Property": "fiscal_week_label"
                }
              },
              "queryRef": "Dim_Date.fiscal_week_label",
              "nativeQueryRef": "fiscal_week_label",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_PromoCalendar"
                    }
                  },
                  "Property": "Promo Events TY"
                }
              },
              "queryRef": "Fact_PromoCalendar.Promo Events TY",
              "nativeQueryRef": "Promo Events TY"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_PromoCalendar"
                    }
                  },
                  "Property": "Incremental Units"
                }
              },
              "queryRef": "Fact_PromoCalendar.Incremental Units",
              "nativeQueryRef": "Incremental Units"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}