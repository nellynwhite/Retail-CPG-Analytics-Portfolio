{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "p4_bar_supplier",
  "position": {
    "x": 610,
    "y": 260,
    "z": 5,
    "height": 270,
    "width": 620,
    "tabOrder": 5
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Supplier"
                    }
                  },
                  "Property": "supplier_name"
                }
              },
              "queryRef": "Dim_Supplier.supplier_name",
              "nativeQueryRef": "supplier_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_PromoCalendar"
                    }
                  },
                  "Property": "Total Trade Spend"
                }
              },
              "queryRef": "Fact_PromoCalendar.Total Trade Spend",
              "nativeQueryRef": "Total Trade Spend"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_PromoCalendar"
                    }
                  },
                  "Property": "Incremental Units"
                }
              },
              "queryRef": "Fact_PromoCalendar.Incremental Units",
              "nativeQueryRef": "Incremental Units"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}