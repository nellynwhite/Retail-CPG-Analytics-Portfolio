{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "p5_wm_bar_freight_split",
  "position": {
    "x": 30,
    "y": 500,
    "z": 19,
    "height": 280,
    "width": 580,
    "tabOrder": 19
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Supplier"
                    }
                  },
                  "Property": "supplier_name"
                }
              },
              "queryRef": "Dim_Supplier.supplier_name",
              "nativeQueryRef": "supplier_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_SupplyChain"
                    }
                  },
                  "Property": "Collect Ready Rate"
                }
              },
              "queryRef": "Fact_SupplyChain.Collect Ready Rate",
              "nativeQueryRef": "Collect Ready Rate"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_SupplyChain"
                    }
                  },
                  "Property": "Prepaid On-Time Rate"
                }
              },
              "queryRef": "Fact_SupplyChain.Prepaid On-Time Rate",
              "nativeQueryRef": "Prepaid On-Time Rate"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'On-Time by Freight Type'"
                }
              }
            }
          }
        }
      ]
    }
  }
}